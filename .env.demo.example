# Demo build configuration. Copy to .env.demo (git-ignored).
#
# Vite also loads the root .env in every mode, so EVERY key below must be set here
# or the demo would inherit production values. The app refuses to start unless
# VITE_FIREBASE_PROJECT_ID contains "demo".
VITE_DEMO_MODE=true

# Web app config of the dedicated demo Firebase project (Console -> Project settings -> Your apps).
VITE_FIREBASE_API_KEY=your-demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=tarbiyah-sms-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tarbiyah-sms-demo
VITE_FIREBASE_STORAGE_BUCKET=tarbiyah-sms-demo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-demo-sender-id
VITE_FIREBASE_APP_ID=your-demo-app-id

# Must match DEMO_PASSWORD used when seeding. It is embedded in the built site
# (the sign-in buttons use it), so only ever use a throwaway demo password.
VITE_DEMO_PASSWORD=DemoSchool-2026

# Set to true to run against the local Firebase emulators instead of a cloud project.
VITE_USE_EMULATORS=false

# Leave blank: the demo has no Google Calendar / Sheets integration.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_CLIENT_ID=
